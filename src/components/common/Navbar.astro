---
// Navbar.astro: Global minimalist navbar with scroll effects and active state tracking.
---
<nav id="global-navbar" class="navbar-symmetric fixed top-0 left-0 w-full z-40 transition-colors duration-500 text-[#1A1A1A] bg-transparent">

  <!-- Col 1: Logo -->
  <a href="#" class="navbar-col navbar-col--left flex items-center gap-2.5 decoration-none no-underline group select-none">
    <img src="/logo.png" alt="Logo" id="navbar-logo" class="h-8 md:h-10 w-auto object-contain transition-all duration-500" />
  </a>

  <!-- Col 2: Brand name (center) -->
  <div class="navbar-col navbar-col--center">
    <span id="navbar-brand-name" class="font-display text-sm md:text-base font-bold tracking-[2px] md:tracking-[4px] uppercase transition-colors duration-500 whitespace-nowrap">
      La Casa de la Hamburpizza
    </span>
  </div>

  <!-- Col 3: Nav links & Hamburger -->
  <div class="navbar-col navbar-col--right flex items-center justify-end">
    <!-- Desktop Links (Tablet & Desktop only) -->
    <div class="navbar-desktop-links gap-5 md:gap-8 font-sans text-xs md:text-sm uppercase font-bold tracking-[1px] md:tracking-[2px] items-center">
      <button class="hover:text-[#E62020] transition-colors duration-300 cursor-pointer btn-toggle-editorial text-[var(--color-brand-red)]" id="global-nav-btn-editorial">
        Carta
      </button>
      <button class="hover:text-[#E62020] transition-colors duration-300 cursor-pointer btn-toggle-gallery" id="global-nav-btn-gallery">
        Galería
      </button>
      <a class="hover:text-[#E62020] transition-colors duration-300 decoration-none no-underline" href="#dossier-section">
        Info
      </a>
    </div>

    <!-- Hamburger Button (Mobile only) -->
    <button id="mobile-menu-btn" class="navbar-mobile-menu-btn flex-col justify-center items-center w-10 h-10 cursor-pointer z-50 text-current focus:outline-none transition-colors duration-300" aria-label="Abrir menú">
      <span class="w-6 h-[2px] bg-current transition-all duration-300 translate-y-[-6px]" id="bar-top"></span>
      <span class="w-6 h-[2px] bg-current transition-all duration-300" id="bar-middle"></span>
      <span class="w-6 h-[2px] bg-current transition-all duration-300 translate-y-[6px]" id="bar-bottom"></span>
    </button>
  </div>
</nav>

<!-- Mobile Menu Overlay (Fullscreen with premium glassmorphism) -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-[#1A1A1A]/95 backdrop-blur-xl z-30 flex flex-col justify-center items-center transition-all duration-500 opacity-0 pointer-events-none">
  <div class="flex flex-col gap-8 text-center font-display text-4xl uppercase tracking-wider text-white">
    <button class="mobile-nav-link hover:text-[#E62020] transition-colors duration-300 btn-toggle-editorial cursor-pointer" id="mobile-nav-btn-editorial">
      Carta
    </button>
    <button class="mobile-nav-link hover:text-[#E62020] transition-colors duration-300 btn-toggle-gallery cursor-pointer" id="mobile-nav-btn-gallery">
      Galería
    </button>
    <a class="mobile-nav-link hover:text-[#E62020] transition-colors duration-300 no-underline decoration-none" href="#dossier-section" id="mobile-nav-link-info">
      Info
    </a>
  </div>
</div>

<style>
  /* ─── Symmetric Navbar: Responsive Flexbox/Grid ─────────────────── */
  .navbar-symmetric {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
  }

  @media (min-width: 768px) {
    .navbar-symmetric {
      padding: 14px 32px;
    }
  }

  @media (min-width: 1024px) {
    .navbar-symmetric {
      display: grid;
      grid-template-columns: 1fr 1.5fr 1fr;
      align-items: center;
      padding: 14px 48px;
      gap: 1.5rem;
    }
  }

  /* Each column is a flex container for alignment control */
  .navbar-col {
    display: flex;
    align-items: center;
  }

  .navbar-col--left {
    justify-content: flex-start;
  }

  /* Specifying .navbar-col.navbar-col--center to increase specificity and successfully override display: flex */
  .navbar-col.navbar-col--center {
    justify-content: center;
    text-align: center;
    display: none; /* Hidden on mobile/tablets by default */
  }

  @media (min-width: 1024px) {
    .navbar-col.navbar-col--center {
      display: flex; /* Shown only on desktop */
    }
  }

  .navbar-col--right {
    justify-content: flex-end;
    width: auto;
  }

  @media (min-width: 1024px) {
    .navbar-col--right {
      width: 100%;
    }
  }

  /* Responsive Display classes for desktop links and mobile menu button */
  .navbar-desktop-links {
    display: none;
  }

  .navbar-mobile-menu-btn {
    display: flex;
  }

  @media (min-width: 768px) {
    .navbar-desktop-links {
      display: flex;
    }
    .navbar-mobile-menu-btn {
      display: none;
    }
  }

  /* Active nav item state (defined globally to prevent Astro styling scope issues when toggling via JS) */
  :global(.active-nav-item) {
    color: #E62020 !important;
  }

  /* Hamburger morphing to X */
  #mobile-menu-btn.is-open #bar-top {
    transform: translateY(6px) rotate(45deg);
  }
  #mobile-menu-btn.is-open #bar-middle {
    opacity: 0;
    transform: scaleX(0);
  }
  #mobile-menu-btn.is-open #bar-bottom {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Ensure hamburger is white when open, regardless of navbar state */
  #mobile-menu-btn.is-open {
    color: #ffffff !important;
  }

  /* Mobile Overlay visibility */
  #mobile-menu-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initNavbarAnimations() {
    if ((window as any).__navbarInitialized) return;
    (window as any).__navbarInitialized = true;

    const navbar = document.getElementById('global-navbar');
    const brandName = document.getElementById('navbar-brand-name');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (!navbar) return;

    let lastScrollY = window.scrollY;
    let isHidden = false;

    // 1. Show/Hide on Scroll direction (GSAP)
    window.addEventListener('scroll', () => {
      // If mobile menu is open, do not hide navbar
      if (mobileMenuBtn && mobileMenuBtn.classList.contains('is-open')) return;

      const currentScrollY = window.scrollY;

      // Only toggle if scrolled past a threshold
      if (currentScrollY > 100) {
        if (currentScrollY > lastScrollY && !isHidden) {
          // Scrolling down -> hide navbar
          gsap.to(navbar, {
            y: -100,
            opacity: 0,
            duration: 0.4,
            ease: 'power3.out'
          });
          isHidden = true;
        } else if (currentScrollY < lastScrollY && isHidden) {
          // Scrolling up -> show navbar
          gsap.to(navbar, {
            y: 0,
            opacity: 1,
            duration: 0.4,
            ease: 'power3.out'
          });
          isHidden = false;
        }
      } else {
        // Always show near top
        gsap.to(navbar, {
          y: 0,
          opacity: 1,
          duration: 0.3,
          ease: 'power2.out'
        });
        isHidden = false;
      }
      lastScrollY = currentScrollY;
    }, { passive: true });

    // 2. Change Theme on Scroll (Deterministic Native Event to prevent height-toggling bugs in Gallery)
    function updateNavbarTheme() {
      const currentScrollY = window.scrollY;
      const threshold = window.innerHeight * 0.8; // Change theme at 80% viewport height

      if (currentScrollY > threshold) {
        // Scrolled down -> Dark Navbar
        gsap.to(navbar, {
          backgroundColor: 'rgba(26, 26, 26, 0.85)',
          backdropFilter: 'blur(12px)',
          borderColor: 'rgba(255, 255, 255, 0.1)',
          borderBottomWidth: '1px',
          paddingTop: '12px',
          paddingBottom: '12px',
          color: '#ffffff',
          duration: 0.4,
          ease: 'power2.out',
          overwrite: 'auto'
        });
        if (brandName) brandName.style.color = '#ffffff';
      } else {
        // Near top -> Transparent / Light Navbar
        gsap.to(navbar, {
          backgroundColor: 'rgba(26, 26, 26, 0)',
          backdropFilter: 'blur(0px)',
          borderBottomWidth: '0px',
          paddingTop: '14px',
          paddingBottom: '14px',
          color: '#1A1A1A',
          duration: 0.4,
          ease: 'power2.out',
          overwrite: 'auto'
        });
        if (brandName) brandName.style.color = '#1A1A1A';
      }
    }

    window.addEventListener('scroll', updateNavbarTheme, { passive: true });
    window.addEventListener('resize', updateNavbarTheme);
    updateNavbarTheme(); // Run initially

    // 3. Mobile Menu Toggle Logic
    function openMobileMenu() {
      if (!mobileMenuBtn || !mobileMenuOverlay) return;
      mobileMenuBtn.classList.add('is-open');
      mobileMenuOverlay.classList.add('is-active');
      document.body.classList.add('modal-open');
      (window as any).lenis?.stop();

      // GSAP Staggered entry for links
      gsap.fromTo(mobileLinks,
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 0.4, stagger: 0.08, ease: 'power3.out', delay: 0.1 }
      );
    }

    function closeMobileMenu() {
      if (!mobileMenuBtn || !mobileMenuOverlay) return;
      mobileMenuBtn.classList.remove('is-open');
      mobileMenuOverlay.classList.remove('is-active');
      document.body.classList.remove('modal-open');
      (window as any).lenis?.start();
    }

    if (mobileMenuBtn) {
      mobileMenuBtn.addEventListener('click', () => {
        const isOpen = mobileMenuBtn.classList.contains('is-open');
        if (isOpen) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      });
    }

    // Close when clicking any link inside the menu
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMobileMenu();
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initNavbarAnimations);
  document.addEventListener('loader-finished', initNavbarAnimations);
</script>
