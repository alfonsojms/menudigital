---
// FloatingCartBar.astro: The sticky action pill at the bottom of the screen showing current cart status.
---
<div 
  id="floating-cart-bar" 
  role="button"
  tabindex="0"
  aria-label="Ver resumen de pedido y total"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 w-[90%] max-w-[480px] z-40 bg-[var(--color-brand-yellow)] text-black rounded-full shadow-[0_12px_40px_rgba(0,0,0,0.6)] flex items-center justify-between px-6 py-4 cursor-pointer select-none border border-[var(--color-brand-yellow)]/20 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] translate-y-32 opacity-0 pointer-events-none hover:scale-[1.02] active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#1A1A1A]"
>
  <!-- Left Side: Item Count & Icon -->
  <div class="flex items-center gap-3">
    <span class="material-symbols-outlined text-xl font-bold" aria-hidden="true">shopping_bag</span>
    <div class="flex flex-col">
      <span class="text-[10px] font-mono uppercase tracking-widest font-bold opacity-60">Tu Pedido</span>
      <span id="cart-bar-count" class="text-xs font-sans font-bold uppercase tracking-wide">0 platos añadidos</span>
    </div>
  </div>

  <!-- Right Side: Total Price & CTA Arrow -->
  <div class="flex items-center gap-3">
    <span id="cart-bar-total" class="font-mono text-base font-black">$0.00</span>
    <span class="material-symbols-outlined text-lg font-bold" aria-hidden="true">arrow_forward</span>
  </div>
</div>

<script>
  import { getCart, getCartTotal, getCartItemsCount } from '../../utils/cartStore';

  const cartBar = document.getElementById('floating-cart-bar');
  const countVal = document.getElementById('cart-bar-count');
  const totalVal = document.getElementById('cart-bar-total');

  function updateCartBar() {
    const count = getCartItemsCount();
    const total = getCartTotal();

    if (count > 0) {
      // Update values
      if (countVal) countVal.innerText = `${count} ${count === 1 ? 'antojo añadido' : 'antojos añadidos'}`;
      if (totalVal) totalVal.innerText = `$${total.toFixed(2)}`;

      // Animate in
      if (cartBar) {
        cartBar.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
      }
    } else {
      // Animate out
      if (cartBar) {
        cartBar.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
      }
    }
  }

  // Bind click & keyboard event to trigger the main order summary panel
  function openOrderSheet() {
    document.dispatchEvent(new CustomEvent('open-order-sheet'));
  }

  cartBar?.addEventListener('click', openOrderSheet);
  cartBar?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      openOrderSheet();
    }
  });

  // Listen for cart changes
  document.addEventListener('cart-updated', updateCartBar);

  // Initial check
  document.addEventListener('DOMContentLoaded', updateCartBar);
  document.addEventListener('loader-finished', updateCartBar);
</script>
