---
// MenuGallery.astro: The high-density grid view of the menu with search and category filters.
import { menuData } from '../../types/menuData';
---
<div id="gallery-view" class="hidden w-full bg-[#F2EFE9] text-[#1C1B19] min-h-screen">
  
  <header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-b-charcoal/20 px-4 py-3 bg-[#F2EFE9] sticky top-0 z-40">
    <div class="flex items-center gap-4 text-charcoal">
      <div class="size-4">
        <svg fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path d="M39.5563 34.1455V13.8546C39.5563 15.708 36.8773 17.3437 32.7927 18.3189C30.2914 18.916 27.263 19.2655 24 19.2655C20.737 19.2655 17.7086 18.916 15.2073 18.3189C11.1227 17.3437 8.44365 15.708 8.44365 13.8546V34.1455C8.44365 35.9988 11.1227 37.6346 15.2073 38.6098C17.7086 39.2069 20.737 39.5564 24 39.5564C27.263 39.5564 30.2914 39.2069 32.7927 38.6098C36.8773 37.6346 39.5563 35.9988 39.5563 34.1455Z" fill="currentColor"></path>
          <path clip-rule="evenodd" d="M10.4485 13.8519C10.4749 13.9271 10.6203 14.246 11.379 14.7361C12.298 15.3298 13.7492 15.9145 15.6717 16.3735C18.0007 16.9296 20.8712 17.2655 24 17.2655C27.1288 17.2655 29.9993 16.9296 32.3283 16.3735C34.2508 15.9145 35.702 15.3298 36.621 14.7361C37.3796 14.246 37.5251 13.9271 37.5515 13.8519C37.5287 13.7876 37.4333 13.5973 37.0635 13.2931C36.5266 12.8516 35.6288 12.3647 34.343 11.9175C31.79 11.0295 28.1333 10.4437 24 10.4437C19.8667 10.4437 16.2099 11.0295 13.657 11.9175C12.3712 12.3647 11.4734 12.8516 10.9365 13.2931C10.5667 13.5973 10.4713 13.7876 10.4485 13.8519ZM37.5563 18.7877C36.3176 19.3925 34.8502 19.8839 33.2571 20.2642C30.5836 20.9025 27.3973 21.2655 24 21.2655C20.6027 21.2655 17.4164 20.9025 14.7429 20.2642C13.1498 19.8839 11.6824 19.3925 10.4436 18.7877V34.1275C10.4515 34.1545 10.5427 34.4867 11.379 35.027C12.298 35.6207 13.7492 36.2054 15.6717 36.6644C18.0007 37.2205 20.8712 37.5564 24 37.5564C27.1288 37.5564 29.9993 37.2205 32.3283 36.6644C34.2508 36.2054 35.702 35.6207 36.621 35.027C37.4573 34.4867 37.5485 34.1546 37.5563 34.1275V18.7877ZM41.5563 13.8546V34.1455C41.5563 36.1078 40.158 37.5042 38.7915 38.3869C37.3498 39.3182 35.4192 40.0389 33.2571 40.5551C30.5836 41.1934 27.3973 41.5564 24 41.5564C20.6027 41.5564 17.4164 41.1934 14.7429 40.5551C12.5808 40.0389 10.6502 39.3182 9.20848 38.3869C7.84205 37.5042 6.44365 36.1078 6.44365 34.1455L6.44365 13.8546C6.44365 12.2684 7.37223 11.0454 8.39581 10.2036C9.43325 9.3505 10.8137 8.67141 12.343 8.13948C15.4203 7.06909 19.5418 6.44366 24 6.44366C28.4582 6.44366 32.5797 7.06909 35.657 8.13948C37.1863 8.67141 38.5667 9.3505 39.6042 10.2036C40.6278 11.0454 41.5563 12.2684 41.5563 13.8546Z" fill="currentColor" fill-rule="evenodd"></path>
        </svg>
      </div>
      <h2 class="text-charcoal text-lg font-bold leading-tight tracking-[-0.015em] font-display">L'Éphémère</h2>
    </div>
    <nav class="hidden md:flex gap-8 text-sm uppercase tracking-widest font-mono text-fennel">
      <button class="hover:text-charcoal transition-colors cursor-pointer btn-toggle-editorial">Menu</button>
      <button class="hover:text-charcoal transition-colors cursor-pointer text-charcoal font-bold btn-toggle-gallery">Gallery</button>
      <a class="hover:text-charcoal transition-colors" href="#dossier-section">Info</a>
    </nav>
  </header>
  
  <!-- Search and Filter Header -->
  <div class="px-6 md:px-12 py-8 border-b border-[#1C1B19]/20 sticky top-[72px] bg-[#F2EFE9]/95 backdrop-blur-md z-30">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 max-w-[1800px] mx-auto">
      
      <!-- Search Input -->
      <div class="relative w-full lg:w-80">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#9C978D] text-lg select-none">
          search
        </span>
        <input 
          id="gallery-search"
          class="w-full bg-transparent border border-[#1C1B19] py-2.5 pl-10 pr-4 text-xs font-mono uppercase tracking-[2px] focus:ring-0 focus:border-[var(--color-primary)] placeholder:text-[#9C978D]/50 outline-none rounded-none" 
          placeholder="Search menu..." 
          type="text"
        />
      </div>

      <!-- Category Filter Tabs -->
      <nav class="flex flex-wrap items-center gap-2" id="gallery-filters">
        <button class="filter-btn active px-4 py-2 border border-[#1C1B19] text-[10px] font-mono uppercase tracking-widest transition-colors duration-300 hover:bg-[#1C1B19] hover:text-[#F2EFE9]" data-filter="all">
          All
        </button>
        <button class="filter-btn px-4 py-2 border border-[#1C1B19] text-[10px] font-mono uppercase tracking-widest transition-colors duration-300 hover:bg-[#1C1B19] hover:text-[#F2EFE9]" data-filter="starters">
          Première
        </button>
        <button class="filter-btn px-4 py-2 border border-[#1C1B19] text-[10px] font-mono uppercase tracking-widest transition-colors duration-300 hover:bg-[#1C1B19] hover:text-[#F2EFE9]" data-filter="mains">
          Principale
        </button>
        <button class="filter-btn px-4 py-2 border border-[#1C1B19] text-[10px] font-mono uppercase tracking-widest transition-colors duration-300 hover:bg-[#1C1B19] hover:text-[#F2EFE9]" data-filter="desserts">
          Sucré
        </button>
        <button class="filter-btn px-4 py-2 border border-[#1C1B19] text-[10px] font-mono uppercase tracking-widest transition-colors duration-300 hover:bg-[#1C1B19] hover:text-[#F2EFE9]" data-filter="drinks">
          Cave
        </button>
      </nav>
      
    </div>
  </div>

  <!-- High-Density Grid Canvas -->
  <main class="w-full px-6 md:px-12 py-12 max-w-[1800px] mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-y-12 gap-x-6" id="gallery-grid">
      
      {menuData.map(dish => (
        <article 
          class="dish-card group cursor-pointer relative" 
          data-category={dish.category}
          data-dish-id={dish.id}
          data-search-term={dish.name.toLowerCase() + " " + dish.description.toLowerCase()}
        >
          {dish.soldOut && (
            <div class="absolute top-2 right-2 z-10 bg-[var(--color-primary)] text-white text-[9px] font-mono uppercase tracking-tighter px-2 py-0.5 select-none">
              Sold Out
            </div>
          )}
          <div class={`aspect-[4/5] overflow-hidden bg-[#E8E4DA] mb-4 border border-[#1C1B19] ${dish.soldOut ? 'opacity-50 grayscale' : ''}`}>
            <img 
              alt={dish.name} 
              class="dish-image w-full h-full object-cover transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 select-none pointer-events-none" 
              src={dish.image} 
            />
          </div>
          <div class="flex justify-between items-start gap-2">
            <div class="space-y-1">
              <h3 class={`text-sm font-semibold uppercase tracking-tight group-hover:text-[var(--color-primary)] transition-colors duration-300 ${dish.soldOut ? 'line-through opacity-50' : ''}`}>
                {dish.name}
              </h3>
              <p class="text-[11px] text-[#9C978D] font-sans leading-tight pr-4">
                {dish.description}
              </p>
            </div>
            <span class="font-mono text-xs font-bold text-[var(--color-primary)]">{dish.price}</span>
          </div>
        </article>
      ))}
      
    </div>

    <!-- Empty State -->
    <div id="gallery-empty-state" class="hidden text-center py-20">
      <p class="font-display italic text-2xl text-[#9C978D]">No dishes match your search.</p>
    </div>
  </main>
</div>

<style>
  /* Gray filter for card images, colorized on hover */
  .dish-image {
    filter: grayscale(40%);
  }
  .group:hover .dish-image {
    filter: grayscale(0%);
  }

  /* Active Filter Button */
  .filter-btn.active {
    background-color: #1C1B19;
    color: #F2EFE9;
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Client-side search and filtering logic
  const searchInput = document.getElementById('gallery-search') as HTMLInputElement;
  const filterButtons = document.querySelectorAll('#gallery-filters .filter-btn');
  const dishCards = document.querySelectorAll('#gallery-grid .dish-card');
  const emptyState = document.getElementById('gallery-empty-state');

  let activeFilter = 'all';
  let searchQuery = '';

  function filterGallery() {
    let visibleCount = 0;

    dishCards.forEach(card => {
      const cardCategory = card.getAttribute('data-category') || '';
      const searchTerm = card.getAttribute('data-search-term') || '';
      
      const matchesCategory = activeFilter === 'all' || cardCategory === activeFilter;
      const matchesSearch = searchTerm.includes(searchQuery);

      if (matchesCategory && matchesSearch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    // Toggle empty state
    if (visibleCount === 0) {
      emptyState?.classList.remove('hidden');
    } else {
      emptyState?.classList.add('hidden');
    }
  }

  // Bind Search Input
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterGallery();
  });

  // Bind Filter Buttons
  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.getAttribute('data-filter') || 'all';

      // Soft transition animation using GSAP
      gsap.to('#gallery-grid', {
        opacity: 0,
        y: 10,
        duration: 0.25,
        ease: 'power2.out',
        onComplete: () => {
          filterGallery();
          gsap.to('#gallery-grid', {
            opacity: 1,
            y: 0,
            duration: 0.4,
            ease: 'power2.out'
          });
        }
      });
    });
  });
</script>
