---
// MenuGallery.astro: The high-density grid view of the menu with search and category filters.
import { menuData } from '../../types/menuData';
import Badge from '../common/Badge.astro';
import AddToCartBtn from '../common/AddToCartBtn.astro';
---
<div id="gallery-view" class="hidden w-full bg-[#1A1A1A] text-white min-h-screen">
  
  <!-- Search and Filter Header -->
  <div class="px-6 md:px-12 pb-8 pt-20 md:pt-24 border-b border-white/10 bg-[#1A1A1A]">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 max-w-[1800px] mx-auto">
      
      <!-- Search Input -->
      <div class="relative w-full lg:w-80">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-white/40 text-lg select-none">
          search
        </span>
        <input 
          id="gallery-search"
          class="w-full bg-transparent border border-white/20 py-2.5 pl-10 pr-4 text-xs font-mono uppercase tracking-[2px] focus:ring-0 focus:border-[var(--color-brand-yellow)] text-white placeholder:text-white/30 outline-none rounded-none" 
          placeholder="Buscar antojo..." 
          type="text"
          aria-label="Buscar plato en la galería"
        />
      </div>

      <!-- Category Filter Tabs -->
      <nav class="flex flex-wrap items-center gap-2" id="gallery-filters">
        <button class="filter-btn active px-4 py-2 border border-white/20 text-[10px] font-sans uppercase font-bold tracking-widest transition-colors duration-300 hover:bg-[var(--color-brand-yellow)] hover:text-black" data-filter="all">
          Todo
        </button>
        <button class="filter-btn px-4 py-2 border border-white/20 text-[10px] font-sans uppercase font-bold tracking-widest transition-colors duration-300 hover:bg-[var(--color-brand-yellow)] hover:text-black" data-filter="starters">
          Entradas
        </button>
        <button class="filter-btn px-4 py-2 border border-white/20 text-[10px] font-sans uppercase font-bold tracking-widest transition-colors duration-300 hover:bg-[var(--color-brand-yellow)] hover:text-black" data-filter="mains">
          Hamburguesas & Pizzas
        </button>
        <button class="filter-btn px-4 py-2 border border-white/20 text-[10px] font-sans uppercase font-bold tracking-widest transition-colors duration-300 hover:bg-[var(--color-brand-yellow)] hover:text-black" data-filter="desserts">
          Postres
        </button>
        <button class="filter-btn px-4 py-2 border border-white/20 text-[10px] font-sans uppercase font-bold tracking-widest transition-colors duration-300 hover:bg-[var(--color-brand-yellow)] hover:text-black" data-filter="drinks">
          Bebidas
        </button>
      </nav>
      
    </div>
  </div>

  <!-- High-Density Grid Canvas -->
  <main class="w-full px-6 md:px-12 py-12 max-w-[1800px] mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-y-12 gap-x-6" id="gallery-grid">
      
      {menuData.map(dish => (
        <article 
          class="dish-card group cursor-pointer relative outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-yellow)] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1A1A1A] rounded-md p-1" 
          data-category={dish.category}
          data-dish-id={dish.id}
          data-search-term={dish.name.toLowerCase() + " " + dish.description.toLowerCase()}
          tabindex="0"
          role="button"
          aria-haspopup="dialog"
          aria-label={`Ver detalles de ${dish.name}`}
        >
          {dish.soldOut && (
            <Badge variant="soldOut" label="Agotado" class="absolute top-2 right-2 z-10" />
          )}
          <div class={`aspect-[4/5] overflow-hidden bg-[#262626] mb-4 border border-white/10 ${dish.soldOut ? 'opacity-50 grayscale' : ''}`}>
            <img 
              alt={dish.name} 
              class="dish-image w-full h-full object-cover transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 select-none pointer-events-none" 
              src={dish.image} 
            />
          </div>
          <div class="flex justify-between items-start gap-2">
            <div class="space-y-1">
              <h3 class={`text-sm font-bold uppercase tracking-tight group-hover:text-[var(--color-brand-yellow)] transition-colors duration-300 ${dish.soldOut ? 'line-through opacity-50' : ''}`}>
                {dish.name}
              </h3>
              <p class="text-[11px] text-white/50 font-sans leading-tight pr-4">
                {dish.description}
              </p>
            </div>
            <div class="flex flex-col items-end gap-2 shrink-0">
              <span class="font-mono text-xs font-bold text-[var(--color-brand-yellow)]">${dish.price}</span>
              {!dish.soldOut && (
                <AddToCartBtn
                  dishId={dish.id}
                  dishName={dish.name}
                  dishPrice={dish.price}
                  dishImage={dish.image}
                />
              )}
            </div>
          </div>
        </article>
      ))}
      
    </div>

    <!-- Empty State -->
    <div id="gallery-empty-state" class="hidden text-center py-20">
      <p class="font-display italic text-2xl text-white/40">No hay productos que coincidan.</p>
    </div>
  </main>
</div>

<style>
  /* Gray filter for card images, colorized on hover */
  .dish-image {
    filter: grayscale(20%);
  }
  .group:hover .dish-image {
    filter: grayscale(0%);
  }

  /* Active Filter Button */
  .filter-btn.active {
    background-color: var(--color-brand-yellow);
    color: #1A1A1A;
    border-color: var(--color-brand-yellow);
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Client-side search and filtering logic
  const searchInput = document.getElementById('gallery-search') as HTMLInputElement;
  const filterButtons = document.querySelectorAll('#gallery-filters .filter-btn');
  const dishCards = document.querySelectorAll('#gallery-grid .dish-card');
  const emptyState = document.getElementById('gallery-empty-state');

  let activeFilter = 'all';
  let searchQuery = '';

  function filterGallery() {
    let visibleCount = 0;

    dishCards.forEach(card => {
      const cardCategory = card.getAttribute('data-category') || '';
      const searchTerm = card.getAttribute('data-search-term') || '';
      
      const matchesCategory = activeFilter === 'all' || cardCategory === activeFilter;
      const matchesSearch = searchTerm.includes(searchQuery);

      if (matchesCategory && matchesSearch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    // Toggle empty state
    if (visibleCount === 0) {
      emptyState?.classList.remove('hidden');
    } else {
      emptyState?.classList.add('hidden');
    }
  }

  // Bind Search Input
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterGallery();
  });

  // Bind Filter Buttons
  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.getAttribute('data-filter') || 'all';

      // Soft transition animation using GSAP
      gsap.to('#gallery-grid', {
        opacity: 0,
        y: 10,
        duration: 0.25,
        ease: 'power2.out',
        onComplete: () => {
          filterGallery();
          gsap.to('#gallery-grid', {
            opacity: 1,
            y: 0,
            duration: 0.4,
            ease: 'power2.out'
          });
        }
      });
    });
  });

</script>
