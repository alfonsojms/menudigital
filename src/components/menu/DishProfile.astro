---
// DishProfile.astro: Fixed overlay modal displaying detailed dish profiles.
---
<div id="dish-profile-modal" class="fixed inset-0 w-screen h-screen z-50 flex flex-col md:flex-row bg-[#1A1A1A] translate-y-full opacity-0 pointer-events-none transition-all duration-300">
  
  <!-- Left Panel: Full Bleed Hero Image -->
  <div class="relative w-full h-[40vh] md:h-full md:w-1/2 overflow-hidden" id="dish-modal-image-container">
    <div class="absolute inset-0 bg-cover bg-center" id="dish-modal-image"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/30 to-transparent"></div>
  </div>

  <!-- Right Panel: Text Content -->
  <div class="relative w-full h-[60vh] md:h-full md:w-1/2 flex flex-col bg-[#1A1A1A] custom-scrollbar overflow-y-auto pt-12 pb-20 md:py-24 px-8 md:px-16 lg:px-24" data-lenis-prevent>
    
    <!-- Close Button -->
    <button 
      id="close-dish-modal"
      aria-label="Close Dish Profile" 
      class="fixed top-6 right-6 md:top-8 md:right-8 z-50 text-white transition-all duration-500 ease-out close-btn p-2 cursor-pointer outline-none hover:rotate-90 hover:text-[var(--color-brand-yellow)]"
    >
      <span class="material-symbols-outlined thin text-[36px] md:text-[48px] leading-none">close</span>
    </button>

    <!-- Content Container -->
    <div class="my-auto max-w-xl" id="dish-modal-content">
      <!-- Sub-title / Metadata -->
      <p class="font-mono text-xs md:text-[14px] uppercase tracking-[2px] text-[var(--color-brand-yellow)] mb-4 md:mb-6 font-bold" id="dish-modal-subtitle">
        Local Farms, Day 04
      </p>
      
      <!-- Dish Title -->
      <h1 class="font-display text-[36px] md:text-[56px] lg:text-[64px] leading-[1.1] text-white mb-8 md:mb-12 tracking-tight" id="dish-modal-title">
        Charred Heirloom Cabbage
      </h1>
      
      <!-- Ingredient List / Body text -->
      <div class="font-sans text-[14px] md:text-[15px] leading-[2] md:leading-[2.2] text-white/80 space-y-6">
        <p id="dish-modal-story" class="text-white/90">
          A study in simplicity and time.
        </p>
        
        <ul class="space-y-3.5 pl-4 mt-6 md:mt-8 list-none text-white/80" id="dish-modal-ingredients">
          <!-- Dynamically injected ingredients -->
        </ul>
        
        <p class="mt-8 md:mt-12 text-[12px] font-mono tracking-wide text-white/40 uppercase" id="dish-modal-allergens">
          Allergens: Alliums, Tree Nuts, Gluten
        </p>
      </div>

      <!-- Cart Add/Remove Controls -->
      <div class="mt-8 border-t border-white/10 pt-8 flex items-center justify-between gap-4">
        <!-- Price Display -->
        <div class="flex flex-col">
          <span class="text-xs font-mono text-white/40 uppercase tracking-widest">Precio</span>
          <span class="text-2xl font-mono font-bold text-[var(--color-brand-yellow)]" id="dish-modal-price">$0.00</span>
        </div>
        
        <!-- Action Button / Quantity Controls -->
        <div id="dish-modal-cart-control" class="relative overflow-hidden h-[44px]">
          <!-- Add Button (shows when Qty = 0) -->
          <button id="dish-modal-add-btn" class="px-6 py-2.5 h-full bg-[var(--color-brand-yellow)] hover:bg-[#F58220] transition-colors duration-300 text-black font-sans font-bold uppercase tracking-wider text-xs rounded-full flex items-center gap-2 cursor-pointer outline-none border-none">
            <span class="material-symbols-outlined text-sm font-bold">shopping_bag</span>
            Añadir al delivery
          </button>
          
          <!-- Qty Adjuster (shows when Qty > 0, initially hidden) -->
          <div id="dish-modal-qty-control" class="hidden flex items-center border border-white/20 rounded-full h-full overflow-hidden bg-white/5">
            <button id="dish-modal-minus-btn" class="w-10 h-full flex items-center justify-center text-white hover:bg-white/10 transition-colors duration-200 cursor-pointer outline-none border-none bg-transparent">
              <span class="material-symbols-outlined text-sm font-bold">remove</span>
            </button>
            <span id="dish-modal-qty-val" class="w-10 text-center font-mono font-bold text-sm">0</span>
            <button id="dish-modal-plus-btn" class="w-10 h-full flex items-center justify-center text-white hover:bg-white/10 transition-colors duration-200 cursor-pointer outline-none border-none bg-transparent">
              <span class="material-symbols-outlined text-sm font-bold">add</span>
            </button>
          </div>
        </div>
      </div>
    </div>
    
  </div>
</div>

<style>
  /* Custom scrollbar for right panel */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.2);
  }
  
  .material-symbols-outlined.thin {
    font-variation-settings: 'wght' 200;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { menuData } from '../../types/menuData';
  import { getCart, addToCart, removeFromCart } from '../../utils/cartStore';

  const modal = document.getElementById('dish-profile-modal');
  const closeBtn = document.getElementById('close-dish-modal');
  const imgContainer = document.getElementById('dish-modal-image-container');
  const imgElement = document.getElementById('dish-modal-image');
  const subtitleElement = document.getElementById('dish-modal-subtitle');
  const titleElement = document.getElementById('dish-modal-title');
  const storyElement = document.getElementById('dish-modal-story');
  const ingredientsList = document.getElementById('dish-modal-ingredients');
  const allergensElement = document.getElementById('dish-modal-allergens');
  const modalContent = document.getElementById('dish-modal-content');
  const priceElement = document.getElementById('dish-modal-price');

  let lastScrollY = 0;
  let isOpen = false;
  let currentDishId = '';

  function updateModalCartState() {
    const cart = getCart();
    const item = cart.find(i => i.id === currentDishId);
    const qty = item ? item.quantity : 0;

    const addBtn = document.getElementById('dish-modal-add-btn');
    const qtyControl = document.getElementById('dish-modal-qty-control');
    const qtyVal = document.getElementById('dish-modal-qty-val');

    if (qty > 0) {
      addBtn?.classList.add('hidden');
      qtyControl?.classList.remove('hidden');
      if (qtyVal) qtyVal.innerText = qty.toString();
    } else {
      addBtn?.classList.remove('hidden');
      qtyControl?.classList.add('hidden');
    }
  }

  function populateModal(dishId: string) {
    const dish = menuData.find(d => d.id === dishId);
    if (!dish) return false;

    currentDishId = dishId;

    // Set text contents
    if (imgElement) imgElement.style.backgroundImage = `url('${dish.image}')`;
    if (subtitleElement) subtitleElement.innerText = dish.subtitle;
    if (titleElement) titleElement.innerText = dish.name;
    if (storyElement) storyElement.innerText = dish.story;
    if (allergensElement) allergensElement.innerText = dish.allergens ? `Alergenos: ${dish.allergens}` : 'Alergenos: Ninguno';
    if (priceElement) priceElement.innerText = `$${dish.price}`;

    // Clear and build ingredients list
    if (ingredientsList) {
      ingredientsList.innerHTML = '';
      dish.ingredients.forEach(ing => {
        const li = document.createElement('li');
        li.className = "relative before:content-[''] before:absolute before:-left-4 before:top-[0.6em] before:w-1.5 before:h-1.5 before:bg-[#F58220] before:rounded-none";
        li.innerText = ing;
        ingredientsList.appendChild(li);
      });
    }

    updateModalCartState();
    return true;
  }

  function openModal(dishId: string) {
    if (isOpen) return;
    
    const success = populateModal(dishId);
    if (!success) return;

    isOpen = true;

    // Stop Lenis smooth scroll
    if ((window as any).lenis) (window as any).lenis.stop();
    
    // Lock body scroll
    document.body.classList.add('modal-open');

    // Make modal visible but transparent initially, then animate
    if (modal) {
      modal.classList.remove('pointer-events-none');
      
      const tl = gsap.timeline({
        defaults: { ease: 'power4.inOut', duration: 1.1 }
      });

      // Slide modal overlay in
      tl.to(modal, {
        y: 0,
        opacity: 1,
        duration: 0.4,
        ease: 'power3.out'
      });

      // Left panel wipe-in clip path
      if (imgContainer) {
        tl.fromTo(imgContainer, 
          { clipPath: 'inset(0 100% 0 0)' }, 
          { clipPath: 'inset(0 0 0 0)', duration: 0.6 },
          '-=0.3'
        );
      }

      // Right panel text elements stagger slide up
      if (modalContent) {
        const textElements = modalContent.children;
        tl.fromTo(textElements, 
          { opacity: 0, y: 30 },
          { opacity: 1, y: 0, stagger: 0.1, duration: 0.8, ease: 'power3.out' },
          '-=0.9'
        );
      }
    }
  }

  function closeModal() {
    if (!isOpen) return;

    isOpen = false;
    
    // Animate out
    if (modal) {
      const tl = gsap.timeline({
        defaults: { ease: 'power2.in', duration: 0.25 },
        onComplete: () => {
          modal.classList.add('pointer-events-none');
          
          // Restore scroll
          document.body.classList.remove('modal-open');

          // Restart Lenis smooth scroll
          if ((window as any).lenis) {
            (window as any).lenis.start();
            (window as any).lenis.resize();
          }
        }
      });

      tl.to(modal, {
        y: '100%',
        opacity: 0
      });
    }
  }

  // Bind custom events to open the modal from other components
  document.addEventListener('open-dish-profile', (e: any) => {
    if (e.detail && e.detail.dishId) {
      openModal(e.detail.dishId);
    }
  });

  closeBtn?.addEventListener('click', closeModal);

  // Cart action listeners
  const addBtn = document.getElementById('dish-modal-add-btn');
  const plusBtn = document.getElementById('dish-modal-plus-btn');
  const minusBtn = document.getElementById('dish-modal-minus-btn');

  addBtn?.addEventListener('click', () => {
    const dish = menuData.find(d => d.id === currentDishId);
    if (dish) {
      addToCart({ id: dish.id, name: dish.name, price: dish.price, image: dish.image });
      updateModalCartState();
    }
  });

  plusBtn?.addEventListener('click', () => {
    const dish = menuData.find(d => d.id === currentDishId);
    if (dish) {
      addToCart({ id: dish.id, name: dish.name, price: dish.price, image: dish.image });
      updateModalCartState();
    }
  });

  minusBtn?.addEventListener('click', () => {
    if (currentDishId) {
      removeFromCart(currentDishId);
      updateModalCartState();
    }
  });

  // Listen for background updates
  document.addEventListener('cart-updated', () => {
    if (isOpen && currentDishId) {
      updateModalCartState();
    }
  });
</script>
