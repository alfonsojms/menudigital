---
// MenuCanvas.astro: Asymmetric editorial layout with starters on left, mains on right, and floating parallax images.
import { menuData } from '../../types/menuData';

const starters = menuData.filter(d => d.category === 'starters');
const mains = menuData.filter(d => d.category === 'mains');
---
<header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-white/10 px-4 py-3 bg-[#1A1A1A]">
  <div class="flex items-center gap-4 text-white">
    <img src="/logo.png" alt="Logo" class="size-8 object-contain" />
    <h2 class="text-white text-lg font-bold leading-tight tracking-[-0.015em] font-display uppercase">La Casa de la Hamburpizza</h2>
  </div>
  <nav class="hidden md:flex gap-8 text-xs uppercase tracking-widest font-sans font-bold text-white/60">
    <button class="hover:text-[var(--color-brand-yellow)] transition-colors cursor-pointer text-[var(--color-brand-yellow)] font-bold btn-toggle-editorial">Carta</button>
    <button class="hover:text-[var(--color-brand-yellow)] transition-colors cursor-pointer btn-toggle-gallery">Galería</button>
    <a class="hover:text-[var(--color-brand-yellow)] transition-colors" href="#dossier-section">Info</a>
  </nav>
</header>

<div id="editorial-view" class="w-full bg-[#1A1A1A] text-white min-h-screen">
  <main class="w-full px-8 md:px-20 lg:px-40 pb-40">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 relative">
      
      <!-- Column 1: Starters (Spans cols 1-5) -->
      <section class="lg:col-span-5 pt-20 lg:pt-32 relative" id="section-starters">
        <h2 class="font-display text-5xl md:text-[64px] leading-none mb-16 border-t border-white/10 pt-6 text-[var(--color-brand-yellow)] gs-reveal uppercase">
          Entradas / Snacks
        </h2>
        <div class="space-y-12">
          {starters.map(dish => (
            <article 
              class="dish-row group relative cursor-pointer" 
              data-dish-id={dish.id} 
              data-image-url={dish.image}
            >
              <div class="hover-dot"></div>
              <div class="flex items-baseline w-full gs-dish">
                <h3 class="text-[16px] font-bold text-white tracking-tight group-hover:text-[var(--color-brand-yellow)] transition-colors duration-300">
                  {dish.name}
                </h3>
                <div class="dotted-leader"></div>
                <span class="font-mono text-[14px] text-[var(--color-brand-yellow)] font-bold">${dish.price}</span>
              </div>
              <p class="text-[13px] text-white/70 mt-1 w-4/5 leading-relaxed gs-dish">
                {dish.description}
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- Column 2: Mains (Spans cols 7-12, offset vertically) -->
      <section class="lg:col-start-7 lg:col-span-6 pt-32 lg:pt-80 relative" id="section-mains">
        <h2 class="font-display text-5xl md:text-[64px] leading-none mb-16 border-t border-white/10 pt-6 text-[var(--color-brand-yellow)] gs-reveal uppercase">
          Hamburguesas & Pizzas
        </h2>
        <div class="space-y-12">
          {mains.map(dish => (
            <article 
              class="dish-row group relative cursor-pointer" 
              data-dish-id={dish.id} 
              data-image-url={dish.image}
            >
              {dish.soldOut && (
                <div class="absolute -left-16 top-0.5 font-mono text-[9px] text-[var(--color-brand-red)] uppercase tracking-widest bg-[var(--color-brand-red)]/10 px-2 py-0.5 border border-[var(--color-brand-red)]/20 select-none">
                  Agotado
                </div>
              )}
              <div class="hover-dot"></div>
              <div class={`flex items-baseline w-full gs-dish ${dish.soldOut ? 'opacity-40' : ''}`}>
                <h3 class={`text-[16px] font-bold text-white tracking-tight group-hover:text-[var(--color-brand-yellow)] transition-colors duration-300 ${dish.soldOut ? 'line-through' : ''}`}>
                  {dish.name}
                </h3>
                <div class="dotted-leader"></div>
                <span class="font-mono text-[14px] text-[var(--color-brand-yellow)] font-bold">${dish.price}</span>
              </div>
              <p class={`text-[13px] text-white/70 mt-1 w-4/5 leading-relaxed gs-dish ${dish.soldOut ? 'opacity-40' : ''}`}>
                {dish.description}
              </p>
            </article>
          ))}
        </div>
      </section>

    </div>
  </main>

  <!-- Floating Mouse-Following Preview Container -->
  <div 
    id="hover-image-preview" 
    class="fixed pointer-events-none z-50 w-[220px] h-[280px] border-3 border-[var(--color-brand-yellow)] bg-[#262626] overflow-hidden scale-0 opacity-0 rounded-lg shadow-[0_15px_30px_rgba(0,0,0,0.5)] transition-transform duration-100"
    style="left: 0; top: 0; transform: translate3d(0, 0, 0);"
  >
    <div id="hover-image-inner" class="w-full h-full bg-cover bg-center transition-all duration-300"></div>
  </div>
</div>

<style>
  /* Hairline borders and dotted leaders */
  .dotted-leader {
    flex-grow: 1;
    border-bottom: 2px dotted rgba(255, 255, 255, 0.2);
    margin: 0 16px;
    position: relative;
    top: -6px;
    opacity: 0.5;
  }

  /* Interactive Hover Dot (Yellow / Orange F58220) */
  .hover-dot {
    position: absolute;
    left: -20px;
    top: 10px;
    transform: scale(0);
    width: 8px;
    height: 8px;
    background-color: #F58220;
    border-radius: 50%;
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dish-row:hover .hover-dot {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initHoverPreview() {
    const preview = document.getElementById('hover-image-preview');
    const inner = document.getElementById('hover-image-inner');
    const rows = document.querySelectorAll('.dish-row[data-image-url]');

    if (!preview || !inner || rows.length === 0) return;

    rows.forEach(row => {
      const imageUrl = row.getAttribute('data-image-url');
      if (!imageUrl) return;

      row.addEventListener('mouseenter', () => {
        // Set background image
        inner.style.backgroundImage = `url('${imageUrl}')`;

        // Scale up and fade in
        gsap.to(preview, {
          scale: 1,
          opacity: 1,
          duration: 0.3,
          ease: 'back.out(1.2)'
        });
      });

      row.addEventListener('mousemove', (e: any) => {
        // Smoothly move preview container to match mouse coordinates with an offset
        gsap.to(preview, {
          x: e.clientX + 20,
          y: e.clientY + 20,
          duration: 0.25,
          ease: 'power2.out',
          overwrite: 'auto'
        });
      });

      row.addEventListener('mouseleave', () => {
        // Scale down and fade out
        gsap.to(preview, {
          scale: 0,
          opacity: 0,
          duration: 0.2,
          ease: 'power2.in'
        });
      });
    });
  }

  // Initialize on loader-finished (when page reveals) and on DOMContentLoaded
  document.addEventListener('DOMContentLoaded', initHoverPreview);
  document.addEventListener('loader-finished', initHoverPreview);
</script>
