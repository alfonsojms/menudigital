---
// Dossier.astro: The elegant info footer containing service details and booking interactions.
---
<footer id="dossier-section" class="w-full border-t border-[#1C1B19] mt-auto bg-[#F2EFE9] text-[#1C1B19]">
  
  <!-- 3-Column Info Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[#1C1B19] border-b border-[#1C1B19]">
    
    <!-- Address -->
    <div class="p-8 md:p-12 lg:p-16 flex flex-col justify-between min-h-[240px]">
      <h3 class="text-[10px] font-mono uppercase tracking-[2px] text-[#9C978D] mb-8 select-none">Location</h3>
      <div>
        <p class="text-xl md:text-2xl font-display leading-relaxed">
          123 Culinary Avenue<br/>
          Meatpacking District<br/>
          NY 10001
        </p>
      </div>
    </div>
    
    <!-- Hours -->
    <div class="p-8 md:p-12 lg:p-16 flex flex-col justify-between min-h-[240px]">
      <h3 class="text-[10px] font-mono uppercase tracking-[2px] text-[#9C978D] mb-8 select-none">Service Hours</h3>
      <div class="font-mono text-xs space-y-3.5 uppercase tracking-wider">
        <div class="flex justify-between border-b border-[#1C1B19]/10 pb-2">
          <span>Wed - Sun</span>
          <span>17:00 — 23:00</span>
        </div>
        <div class="flex justify-between border-b border-[#1C1B19]/10 pb-2">
          <span>Mon - Tue</span>
          <span class="text-[#9C978D]">Closed</span>
        </div>
      </div>
    </div>
    
    <!-- Contact -->
    <div class="p-8 md:p-12 lg:p-16 flex flex-col justify-between min-h-[240px]">
      <h3 class="text-[10px] font-mono uppercase tracking-[2px] text-[#9C978D] mb-8 select-none">Inquiries</h3>
      <div class="space-y-4">
        <a class="block text-xl md:text-2xl font-display hover:text-[var(--color-primary)] transition-colors duration-300" href="mailto:hello@neobistro.com">
          hello@neobistro.com
        </a>
        <a class="block font-mono text-xs hover:text-[var(--color-primary)] transition-colors duration-300" href="tel:+12125550199">
          +1 212 555 0199
        </a>
        <div class="pt-4 flex gap-6">
          <a class="text-[10px] font-mono uppercase tracking-widest hover:text-[var(--color-primary)] transition-colors duration-300" href="#">Instagram</a>
          <a class="text-[10px] font-mono uppercase tracking-widest hover:text-[var(--color-primary)] transition-colors duration-300" href="#">Journal</a>
        </div>
      </div>
    </div>
    
  </div>

  <!-- Booking Button -->
  <button class="booking-btn w-full h-[80px] bg-[#1C1B19] text-[#F2EFE9] hover:bg-[var(--color-primary)] transition-colors duration-500 ease-in-out flex items-center justify-center cursor-pointer rounded-none outline-none border-none">
    <span class="text-initial text-lg md:text-2xl tracking-[4px] uppercase font-bold">Secure A Table</span>
    <span class="text-hover text-lg md:text-2xl tracking-[4px] uppercase font-extrabold hidden">Reserve on Resy</span>
  </button>
  
</footer>

<style>
  /* Button Text Swap on Hover */
  .booking-btn:hover .text-initial {
    display: none;
  }
  .booking-btn:hover .text-hover {
    display: block;
  }
</style>
