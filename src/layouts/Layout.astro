---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>La Casa de la Hamburpizza — Menú Digital</title>
		
		<!-- SEO Meta Tags -->
		<meta name="description" content="Explora el menú digital de La Casa de la Hamburpizza en Trujillo, Venezuela. Hamburpizzas fusionadas, patacones zulianos, perros calientes gigantes y pizzas familiares. ¡Pide directo por WhatsApp!" />
		<meta name="keywords" content="La Casa de la Hamburpizza, Hamburpizza, Hamburpizza Trujillo, menu digital, comida rapida Trujillo, delivery Trujillo, patacon zuliano, perros gigantes, pizza Trujillo" />
		<link rel="canonical" href={Astro.url.href} />

		<!-- Open Graph Meta Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="La Casa de la Hamburpizza — Menú Digital" />
		<meta property="og:description" content="La mejor fusión de hamburguesa y pizza. Disfruta de hamburpizzas, patacones, perros y pizzas en Trujillo con delivery rápido por WhatsApp." />
		<meta property="og:image" content={new URL('/logo.png', Astro.url).href} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:site_name" content="La Casa de la Hamburpizza" />

		<!-- Preconnect and Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Rubik:ital,wght@0,300..900;1,300..900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet" />
		
		<!-- Material Symbols (Thin Icons) -->
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "Restaurant",
				"name": "La Casa de la Hamburpizza",
				"image": "https://lacasadelahamburpizza.com/logo.png",
				"telephone": "+584120721925",
				"priceRange": "$$",
				"servesCuisine": "Venezuelan, Hamburgers, Pizza",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "Av. Coro, Santa Rosa, Al lado de Mami Canguro",
					"addressLocality": "Trujillo",
					"addressRegion": "Trujillo",
					"addressCountry": "VE"
				},
				"openingHoursSpecification": [
					{
						"@type": "OpeningHoursSpecification",
						"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
						"opens": "17:00",
						"closes": "23:00"
					},
					{
						"@type": "OpeningHoursSpecification",
						"dayOfWeek": ["Friday", "Saturday"],
						"opens": "17:00",
						"closes": "00:00"
					},
					{
						"@type": "OpeningHoursSpecification",
						"dayOfWeek": ["Sunday"],
						"opens": "17:00",
						"closes": "23:00"
					}
				]
			}
		</script>
	</head>
	<body class="antialiased selection:bg-[#E62020] selection:text-white">
		<slot />

		<script>
			import Lenis from '@studio-freight/lenis';
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';
			import { addToCart } from '../utils/cartStore';

			gsap.registerPlugin(ScrollTrigger);

			// Initialize Lenis smooth scroll
			const lenis = new Lenis({
				duration: 1.2,
				easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
				smoothWheel: true,
			});

			// Sync ScrollTrigger
			lenis.on('scroll', ScrollTrigger.update);

			gsap.ticker.add((time) => {
				lenis.raf(time * 1000);
			});

			gsap.ticker.lagSmoothing(0);

			// Expose lenis instance globally to allow pausing/starting (e.g. when opening modals)
			(window as any).lenis = lenis;

			// Global Event Delegation for Add-To-Cart buttons
			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				const btn = target.closest('.add-to-cart-btn');
				if (btn) {
					e.stopPropagation(); // Prevent opening the detail modal
					e.preventDefault();
					const dishId = btn.getAttribute('data-dish-id') || '';
					const name = btn.getAttribute('data-dish-name') || '';
					const price = parseFloat(btn.getAttribute('data-dish-price') || '0');
					const image = btn.getAttribute('data-dish-image') || '';
					
					if (dishId) {
						addToCart({ id: dishId, name, price, image });
						gsap.fromTo(btn, { scale: 0.8 }, { scale: 1, duration: 0.2, ease: 'back.out(1.5)' });
					}
				}
			});
		</script>
	</body>
</html>
